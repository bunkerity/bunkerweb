FROM almalinux:10.1@sha256:5e1f19a1fc018dcb17f042411bff68c64cb06131ff1a71356d0be011f87c7baa

ENV NGINX_VERSION=1.30.4

# Copy rocky repo
COPY tests/linux/utils/rocky-10.repo /etc/yum.repos.d/rocky.repo
RUN sed -i "s/%ARCH%/$(uname -m)/g" /etc/yum.repos.d/rocky.repo

# Copy RPM-GPG-KEY-Rocky-10
COPY src/linux/RPM-GPG-KEY-Rocky-10 /etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-10

# Import RPM-GPG-KEY-Rocky-10
RUN rpm --import /etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-10

COPY src/linux/nginx.repo /etc/yum.repos.d/nginx.repo

RUN dnf install https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm -y && \
    dnf install curl php-fpm php-mysqlnd mariadb-server yum-utils -y && \
    dnf install nginx-${NGINX_VERSION} -y

# --- systemd as PID 1 (AlmaLinux has no official -init image; mirror ubi10-init) ---
# systemd is already in the base image; install explicitly for idempotence + clean cache.
RUN dnf -y install systemd && dnf clean all && rm -rf /var/cache/dnf

# Quiet units that are pointless inside a container (systemd 257 auto-detects the
# container and skips most hardware units; we mask the noisy getty/login bits).
RUN systemctl mask \
        getty.target \
        console-getty.service \
        systemd-logind.service \
        dev-hugepages.mount \
        sys-fs-fuse-connections.mount 2>/dev/null || true

STOPSIGNAL SIGRTMIN+3
CMD ["/usr/sbin/init"]
