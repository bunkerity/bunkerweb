-  -- concat the ip and port of the node to the base pool name
-  local pool = (ip or "") .. ":" .. tostring(port or "") .. ":" .. config.base_pool
+  -- Verify seed and routed-node identity, not only the certificate chain.
+  local server_name = config.tls_server_name or (ip or ""):gsub("^%[(.*)%]$", "%1")
+  config.connect_opts.server_name = server_name
