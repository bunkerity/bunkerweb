msgstr "Cabeçalhos do upstream e removidos"

msgid "settings.modsecurity.audit.description"
msgstr "O que o ModSecurity grava em seu próprio log de auditoria, e quanto de cada transação ele mantém. As partes A e Z são sempre incluídas."

msgid "settings.modsecurity.audit.title"
msgstr "Log de auditoria"

msgid "settings.modsecurity.crs.description"
msgstr "O conjunto de regras compartilhado que o BunkerWeb carrega sobre o ModSecurity. A versão 4 é a atual; a versão 3 é mantida para serviços que ainda dependem de seus IDs de regra."

msgid "settings.modsecurity.crs.title"
msgstr "OWASP Core Rule Set"

msgid "settings.modsecurity.crs_plugins.description"
msgstr "Pacotes de regras publicados para o Core Rule Set, baixados e instalados na inicialização. Forneça um nome de plugin, um nome/tag, ou uma URL."

msgid "settings.modsecurity.crs_plugins.title"
msgstr "Plugins do Core Rule Set"

