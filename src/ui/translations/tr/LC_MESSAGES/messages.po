msgid "settings.headers.browser.description"
msgstr "Small fixed-value headers. An empty value removes the header instead of sending it."

msgid "settings.headers.browser.title"
msgstr "Browser protections"

msgid "settings.headers.cookies.description"
msgstr "Flags added to every Set-Cookie the upstream returns. Per-cookie flag rules are in the repeatable settings below."

msgid "settings.headers.cookies.title"
msgstr "Cookies"

msgid "settings.headers.csp.description"
msgstr "The policy sent as Content-Security-Policy. A wrong directive breaks the site's own scripts with nothing to see server-side, so report-only first is the safe order."

msgid "settings.headers.csp.title"
msgstr "Content Security Policy"

msgid "settings.headers.notice.csp_report_only"
msgstr "Report-only is on: the policy goes out as Content-Security-Policy-Report-Only, so violations are reported and nothing is blocked. Turn it off to enforce."

msgid "settings.headers.notice.hsts_preload"
msgstr "This value contains preload. Once the domain is submitted to the browsers' preload list, removal takes months to reach users -- every subdomain is HTTPS-only until then."

msgid "settings.headers.notice.keep_all"
msgstr "The keep list is *, so every header the upstream sends wins over the values configured here."

msgid "settings.headers.notice.keep_shadows"
msgstr "These headers are kept from the upstream when it sends its own, so the values configured here are only a fallback:"

msgid "settings.headers.permissions.description"
msgstr "Which browser features this site may use, as a comma-separated list of feature=(allowlist) clauses. An entry left at () disables that API for everyone, including your own pages."

msgid "settings.headers.permissions.title"
msgstr "Permissions Policy"

msgid "settings.headers.transport.description"
msgstr "The Strict-Transport-Security header. Only sent over HTTPS."

msgid "settings.headers.transport.title"
msgstr "HTTPS enforcement"

msgid "settings.headers.unplaced.description"
msgstr "Declared by the plugin but not yet placed on this page. They still save normally."

msgid "settings.headers.unplaced.title"
msgstr "Other settings"

msgid "settings.headers.upstream.description"
msgstr "Which of the upstream's own response headers survive, and which are stripped before the response leaves."

msgid "settings.headers.upstream.title"
msgstr "Upstream and removed headers"

msgid "settings.modsecurity.audit.description"
msgstr "What ModSecurity writes to its own audit log, and how much of each transaction it keeps. Parts A and Z are always included."

msgid "settings.modsecurity.audit.title"
msgstr "Audit log"

msgid "settings.modsecurity.crs.description"
msgstr "The shared rule set BunkerWeb loads on top of ModSecurity. Version 4 is the current one; version 3 is kept for services that still depend on its rule ids."

msgid "settings.modsecurity.crs.title"
msgstr "OWASP Core Rule Set"

msgid "settings.modsecurity.crs_plugins.description"
msgstr "Rule packs published for the Core Rule Set, downloaded and installed at startup. Give a plugin name, a name/tag, or a URL."

msgid "settings.modsecurity.crs_plugins.title"
msgstr "Core Rule Set plugins"

msgid "settings.modsecurity.engine.description"
msgstr "Whether ModSecurity is loaded at all, and what it does with a rule match."

msgid "settings.modsecurity.engine.title"
msgstr "Engine"

msgid "settings.modsecurity.global_crs.description"
msgstr "Loads the Core Rule Set once for the whole instance instead of once per service. Faster to load with many services, but service-scoped modsec-crs configs are refused while it is on: create a global one and scope it with a Host rule instead."

msgid "settings.modsecurity.global_crs.title"
msgstr "Global CRS mode"

msgid "settings.modsecurity.limits.description"
msgstr "How much of a request body ModSecurity inspects, and what happens to a body that exceeds the limit. NGINX enforces MAX_CLIENT_SIZE first, so a limit above it has no effect."

msgid "settings.modsecurity.limits.title"
msgstr "Request body limits"

msgid "settings.modsecurity.notice.crs_v3_no_plugins"
msgstr "Core Rule Set 3 cannot load plugins. The plugin switch and plugin list are kept and will apply again on version 4, but they do nothing right now."

msgid "settings.modsecurity.notice.engine_detect"
msgstr "SecRuleEngine is DetectionOnly: matches are logged and nothing is blocked."

msgid "settings.modsecurity.notice.engine_off"
msgstr "ModSecurity is enabled but SecRuleEngine is Off, so no request is inspected. These two settings both mean \"on\" and they currently disagree."

msgid "settings.modsecurity.notice.off"
msgstr "ModSecurity is off. Nothing below is applied, but every value is kept and comes back when you turn it on again."

msgid "settings.modsecurity.tuning.crs_plugins_after"
msgstr "After CRS plugins"

msgid "settings.modsecurity.tuning.crs_plugins_before"
msgstr "Before CRS plugins"

