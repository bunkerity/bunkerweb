msgstr "Allow only these countries"

msgid "settings.access_control.country.picker_label"
msgstr "Country rule"

msgid "settings.access_control.country.title"
msgstr "Country rule"

msgid "settings.access_control.enforcement.title"
msgstr "Enforcement"

msgid "settings.access_control.greylist.enforcement.description"
msgstr "The greylist is deny-by-default: while it is on, anything that matches none of the entries below is denied, on HTTP and on stream traffic alike. Add the entries first, then turn it on — a save that enables it with every list empty is refused."

msgid "settings.access_control.greylist.locked_out"
msgstr "Greylisting is on and no entry is configured, so every request to this service is denied. Add at least one entry below, or turn greylisting off."

