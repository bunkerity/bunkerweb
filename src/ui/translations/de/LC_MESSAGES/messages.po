msgstr "The shared rule set BunkerWeb loads on top of ModSecurity. Version 4 is the current one; version 3 is kept for services that still depend on its rule ids."

msgid "settings.modsecurity.crs.title"
msgstr "OWASP Core Rule Set"

msgid "settings.modsecurity.crs_plugins.description"
