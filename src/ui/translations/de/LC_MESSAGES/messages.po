msgid "settings.access_control.blacklist.community.title"
msgstr "Community lists"

msgid "settings.access_control.blacklist.enforcement.description"
msgstr "The blacklist runs after the whitelist, so a client that is whitelisted is never blocked here. On each row, the exception lists override that row's own entries and downloaded lists."

msgid "settings.access_control.country.conflict.clear"
msgstr "Clear the block list"

msgid "settings.access_control.country.conflict.description"
msgstr "Both country lists are stored, and only the allow list is enforced: the block list below is never consulted while an allow list is set."

msgid "settings.access_control.country.description"
msgstr "One rule, not two lists. Allowing a set of countries denies every other country and makes a stored block list dead configuration — BunkerWeb checks the allow list first and never reaches the block list."

msgid "settings.access_control.country.exceptions.description"
msgstr "Requests whose URI matches one of these patterns skip the country rule entirely."

msgid "settings.access_control.country.exceptions.title"
msgstr "Exceptions"

