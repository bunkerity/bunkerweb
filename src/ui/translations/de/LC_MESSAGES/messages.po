msgid "settings.modsecurity.notice.engine_detect"
msgstr "SecRuleEngine is DetectionOnly: matches are logged and nothing is blocked."

msgid "settings.modsecurity.notice.engine_off"
msgstr "ModSecurity is enabled but SecRuleEngine is Off, so no request is inspected. These two settings both mean \"on\" and they currently disagree."

msgid "settings.modsecurity.notice.off"
