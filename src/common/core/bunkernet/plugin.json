{
  "id": "bunkernet",
  "name": "BunkerNet",
  "description": "Share threat data with other BunkerWeb instances via BunkerNet.",
  "version": "1.0",
  "stream": "yes",
  "settings": {
    "USE_BUNKERNET": {
      "context": "multisite",
      "default": "yes",
      "help": "Activate BunkerNet feature.",
      "id": "use-bunkernet",
      "label": "Activate BunkerNet",
      "regex": "^(yes|no)$",
      "type": "check"
    },
    "BUNKERNET_FILTER_HEADERS": {
      "context": "multisite",
      "default": "no",
      "help": "Limit what a BunkerNet report carries. When yes, only the User-Agent, Accept, Accept-Encoding, Accept-Language, Content-Type and Content-Length request headers are sent, and the values ModSecurity matched in headers and cookies are blanked. When no, every request header and the matched values are sent as they are.",
      "id": "bunkernet-filter-headers",
      "label": "Filter reported headers",
      "regex": "^(yes|no)$",
      "type": "check"
    },
    "BUNKERNET_SERVER": {
      "context": "global",
      "default": "https://api.bunkerweb.io",
      "help": "Address of the BunkerNet API.",
      "id": "bunkernet-server",
      "label": "BunkerNet server",
      "regex": "^https?:\\/\\/[\\-\\w@:%.+~#=][\\-\\w\\(\\)!@:%+.~#?&\\/=$]*$",
      "type": "text"
    }
  },
  "jobs": [
    {
      "name": "bunkernet-register",
      "file": "bunkernet-register.py",
      "every": "hour",
      "reload": true
    },
    {
      "name": "bunkernet-data",
      "file": "bunkernet-data.py",
      "every": "day",
      "reload": true
    },
    {
      "name": "bunkernet-send",
      "file": "bunkernet-send.py",
      "every": "hour",
      "reload": true
    }
  ]
}
