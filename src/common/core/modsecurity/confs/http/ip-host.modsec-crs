{#- Pack regex alternatives into chunks of at most budget UTF-8 bytes. patterns: input; out: receives the chunks; skipped: receives patterns longer than budget. -#}
{% macro chunk_into(patterns, out, skipped, budget) %}
    {% set cur = namespace(text="", size=0) %}
    {% for pattern in patterns %}
        {% set size = pattern.encode() | length %}
        {% if size > budget %}
            {% set _ = skipped.append(pattern) %}
        {% elif cur.text and cur.size + 1 + size > budget %}
            {% set _ = out.append(cur.text) %}
            {% set cur.text = pattern %}
            {% set cur.size = size %}
        {% else %}
            {% set cur.size = (cur.size + 1 + size) if cur.text else size %}
            {% set cur.text = (cur.text ~ "|" ~ pattern) if cur.text else pattern %}
        {% endif %}
    {% endfor %}
    {% if cur.text %}{% set _ = out.append(cur.text) %}{% endif %}
{% endmacro %}
{% if USE_MODSECURITY == "yes" and USE_MODSECURITY_CRS == "yes" and USE_MODSECURITY_GLOBAL_CRS == "yes" and SERVER_NAME != "" %}
	{% set re = import("re") %}
	{% set ip_hosts = [] %}
	{% if MULTISITE == "yes" %}
		{% set service_names = [] %}
		{% for service in SERVER_NAME.split() %}
			{% set _ = service_names.extend((all.get(service + "_SERVER_NAME") or service).split()) %}
		{% endfor %}
	{% else %}
		{% set service_names = SERVER_NAME.split() %}
	{% endif %}
	{% for host in service_names %}
		{% if re.match("^(?:\\d{1,3}\\.){3}\\d{1,3}$", host) %}
			{% set escaped = re.escape(host.lower()) %}
		{% elif ":" in host %}
			{% set escaped = "\\[" ~ re.escape(host.lower()) ~ "\\]" %}
		{% else %}
			{% set escaped = "" %}
		{% endif %}
		{% if escaped and escaped not in ip_hosts %}
			{% set _ = ip_hosts.append(escaped) %}
		{% endif %}
	{% endfor %}
	{% if ip_hosts %}
		{#- Size. libModSecurity 3.0.17 (core 1.6.18) refuses to load an @rx operand whose compiled form passes PCRE2's 64 KiB link-size limit (about 1,000 IP literals), and the rules file then fails every reload; 3.0.16 loaded it but the rule never matched. Up to host_cap bytes the single Host regex below is kept as is. Past it, small phase-1 marker rules (IDs 9800300+, host_max_chunks at most), each holding one chunk of at most host_cap bytes, set tx.bw_ip_host and the exception rule tests that variable instead. Hosts past the last chunk lose the exception. -#}
		{% set host_cap = 8192 %}
		{% set host_max_chunks = 100 %}
		{% set host_rx = "^(?:" ~ (ip_hosts | join("|")) ~ ")(?::\\d+)?$" %}
		{% set marker = (host_rx.encode() | length) > host_cap %}
		{% set chunks = [] %}
		{% set skipped = [] %}
		{#- 15 = the "^(?:" and ")(?::\\d+)?$" wrapper around a chunk. -#}
		{% if marker %}{% set _ = chunk_into(ip_hosts, chunks, skipped, host_cap - 15) %}{% endif %}
# CRS 920350 flags a numeric Host header, which is the normal Host of a service named by an IP address.
# One rule for the literals of every service (NGINX routes by Host): any other numeric Host stays enforced.
		{% for chunk in chunks[:host_max_chunks] %}
SecRule REQUEST_HEADERS:Host "@rx ^(?:{{ chunk }})(?::\d+)?$" \
    "id:{{ 9800300 + loop.index0 }},phase:1,pass,t:none,t:lowercase,nolog,setvar:tx.bw_ip_host=1"
		{% endfor %}
		{% if marker %}
SecRule TX:bw_ip_host "@eq 1" \
    "id:9800100,phase:1,pass,t:none,nolog,ctl:ruleRemoveById=920350"
		{% else %}
SecRule REQUEST_HEADERS:Host "@rx {{ host_rx }}" \
    "id:9800100,phase:1,pass,t:none,t:lowercase,nolog,ctl:ruleRemoveById=920350"
		{% endif %}
	{% endif %}
{% endif %}
